# CaresLink - AI Recruitment Agent
# Copy to .env.local and fill in your values

# Clerk (https://dashboard.clerk.com - or use Keyless mode, no keys needed for dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic Claude (get key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Resend Email (https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Calendar (service account JSON, minified to a single line)
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

# CapSolver — auto-solves Cloudflare Turnstile + reCAPTCHA for Nursys verification
# Get API key at https://dashboard.capsolver.com (~$0.80-1.20 per 1K solves)
# Without this key, CAPTCHAs require manual solving in the browser window
CAPSOLVER_API_KEY=
