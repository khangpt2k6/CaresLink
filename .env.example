# CaresLink - AI Recruitment Agent
# Copy to .env.local and fill in your values

# Clerk (https://dashboard.clerk.com - or use Keyless mode, no keys needed for dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini (get key at https://aistudio.google.com/apikey)
GOOGLE_GEMINI_API_KEY=

# Resend Email (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Calendar (service account JSON, minified to a single line)
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=
