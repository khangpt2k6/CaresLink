# CaresLink - AI Recruitment Agent
# Copy to .env.local and fill in your values

# Clerk (https://dashboard.clerk.com - or use Keyless mode, no keys needed for dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic Claude (get key at https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Groq (free tier — get key at https://console.groq.com)
# Set AI_PROVIDER=groq to use Groq instead of Anthropic, or switch via Settings
GROQ_API_KEY=
# AI_PROVIDER=anthropic

# Resend Email (https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Stripe Billing (https://dashboard.stripe.com/)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=
# Backward compatibility: if you only have one paid tier, set STRIPE_PREMIUM_PRICE_ID
# Recommended test tiers:
# - Starter: $9/month
# - Pro: $29/month
STRIPE_PREMIUM_PRICE_ID=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Plan-based AI usage limits (server-side enforced)
AI_FREE_REQUESTS_PER_MINUTE=5
AI_FREE_REQUESTS_PER_DAY=40
AI_FREE_MONTHLY_BUDGET_CENTS=300
AI_STARTER_REQUESTS_PER_MINUTE=30
AI_STARTER_REQUESTS_PER_DAY=400
AI_STARTER_MONTHLY_BUDGET_CENTS=2500
AI_PRO_REQUESTS_PER_MINUTE=60
AI_PRO_REQUESTS_PER_DAY=1500
AI_PRO_MONTHLY_BUDGET_CENTS=7000

# Google Calendar (service account JSON, minified to a single line)
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

# CapSolver — auto-solves Cloudflare Turnstile + reCAPTCHA for Nursys verification
# Get API key at https://dashboard.capsolver.com (~$0.80-1.20 per 1K solves)
# Without this key, CAPTCHAs require manual solving in the browser window
CAPSOLVER_API_KEY=
